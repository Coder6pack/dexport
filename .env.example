# ==============================================================================
# dexport Configuration Template (.env / ~/.dexport.env)
# ==============================================================================

# AI Provider API Keys (Pick one or more)
OPENCODE_API_KEY="opencode-..."         # OpenCode Go (DeepSeek V4, Qwen 3.8, Kimi K3, GLM 5.3)
OPENAI_API_KEY="sk-..."                 # OpenAI (GPT-4o, GPT-4o-mini, o3-mini)
GEMINI_API_KEY="AIza..."                # Google Gemini (gemini-2.5-flash, gemini-2.5-pro)
ANTHROPIC_API_KEY="sk-ant-..."          # Anthropic (claude-3-7-sonnet, claude-3-5-haiku)

# Telegram Bot Remote Control
TELEGRAM_BOT_TOKEN=""                   # From @BotFather on Telegram
TELEGRAM_USER_ID=""                     # From @userinfobot (Your Telegram User ID to lock permissions)

# Default Settings
DEFAULT_MODEL="deepseek-v4-flash"       # Default AI model for summarization & agent chat
DISCORD_CDP_PORT=41829                  # Default Chrome DevTools Protocol port for Discord
